    <string name="app_name">Sense Group Translator</string>

    <!-- Notification Permission -->
    <string name="message_permission_notification">ಅವಶ್ಯಕ ಅನುಮತಿ:\nಅಧಿಸೂಚನೆಗಳು</string>
    <string name="message_permission_notification_detail">ಸ್ಕ್ರೀನ್ ಅನುವಾದಕವನ್ನು ಪ್ರಾರಂಭಿಸಲು, ಅಧಿಸೂಚನೆಗಳಿಗೆ ಅನುಮತಿ ನೀಡಬೇಕು.</string>

    <!-- Overlay Permission -->
    <string name="message_permission_overlay">ಅವಶ್ಯಕ ಅನುಮತಿ:\nಇತರ ಅಪ್ಲಿಕೇಶನ್‌ಗಳ ಮೇಲ್ಮಟ್ಟದಲ್ಲಿ ತೋರಿಸಿ</string>
    <string name="message_permission_overlay_detail">ಸ್ಕ್ರೀನ್ ಅನುವಾದಕವನ್ನು ಪ್ರಾರಂಭಿಸಲು, ಇತರ ಅಪ್ಲಿಕೇಶನ್‌ಗಳ ಮೇಲೆ ತೋರಿಸಲು ಅನುಮತಿ ನೀಡಬೇಕು.</string>
    <string name="message_permission_overlay_denied">ಓವರ್‌ಲೇ ಅನುಮತಿ ನಿರಾಕರಿಸಲಾಗಿದೆ</string>
    <string name="message_permission_overlay_denied_detail">ಓವರ್‌ಲೇ ಅನುಮತಿ ನೀಡಲಾಗಿಲ್ಲ.\nಅಪ್ಲಿಕೇಶನ್ ನಿಷ್ಕ್ರಿಯಗೊಳ್ಳುತ್ತದೆ.</string>

    <!-- MediaProjection token request -->
    <string name="message_media_projection">ಅವಶ್ಯಕ ಅನುಮತಿ:\nಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್</string>
    <string name="message_media_projection_detail">ಸ್ಕ್ರೀನ್ ಅನುವಾದಕವನ್ನು ಪ್ರಾರಂಭಿಸಲು, ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್‌ಗೆ ಅನುಮತಿ ನೀಡಬೇಕು.\n\nಸ್ಕ್ರೀನ್上的 ಮಾಹಿತಿ ಕೇವಲ ಅನುವಾದಕ್ಕಾಗಿ ಉಪಯೋಗಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಅದು ಎಲ್ಲಿಗೂ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಸಂಗ್ರಹಿಸಲಾಗುವುದಿಲ್ಲ.</string>
    <string name="message_media_projection_denied">ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಅನುಮತಿ ನಿರಾಕರಿಸಲಾಗಿದೆ</string>
    <string name="message_media_projection_denied_detail">ಸ್ಕ್ರೀನ್ ರೆಕಾರ್ಡಿಂಗ್ ಅನುಮತಿ ನೀಡಲಾಗಿಲ್ಲ.\nಅಪ್ಲಿಕೇಶನ್ ನಿಷ್ಕ್ರಿಯಗೊಳ್ಳುತ್ತದೆ.</string>

    <!-- Foreground service start notification -->
    <string name="notification_foreground_service">ಅನುುವಾದ ಕಾರ್ಯಕ್ಕಾಗಿ ಸ್ಕ್ರೀನ್ ಕ್ಯಾಪ್ಚರ್ ಕಾರ್ಯವನ್ನು ಬಳಸಲಾಗುತ್ತಿದೆ.</string>
    <string name="title_start_foreground_service">ಮುಖ್ಯ ಸೇವೆ ಪ್ರಾರಂಭವಾಗಿದೆ</string>
    <string name="message_start_foreground_service">ಅಪ್ಲಿಕೇಶನ್ ಸ್ಕ್ರೀನ್ ವಿಷಯವನ್ನು ಹಿಡಿದು ಅನುವಾದಿಸಲು ಪ್ರಮುಖ ಸೇವೆಯನ್ನು ಪ್ರಾರಂಭಿಸುತ್ತದೆ.\n\nಹಿಡಿದ ಚಿತ್ರಗಳನ್ನು ಸಂಗ್ರಹಿಸಿಲ್ಲ ಅಥವಾ ಹೊರಗೆ ಕಳುಹಿಸಲಾಗುವುದಿಲ್ಲ.</string>
    <string name="label_confirm_start_foreground_service">ಪ್ರಾರಂಭಿಸಿ</string>
    <string name="label_dismiss_start_foreground_service">ಮುಗಿಸು</string>
    <string name="snack_message_start_foreground_service">ಅಪ್ಲಿಕೇಶನ್ ಸ್ಕ್ರೀನ್ ವಿಷಯವನ್ನು ಹಿಡಿದು ಅನುವಾದಿಸಲು ಪ್ರಮುಖ ಸೇವೆಯನ್ನು ಪ್ರಾರಂಭಿಸಿದೆ.</string>

