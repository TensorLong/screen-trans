  <string name="message_playstore_update_required">Play Store अपडेट आवश्यक</string>
  <string name="message_playstore_update_required_detail">Play Store सेवा से कनेक्शन विफल रहा।\nयह डिवाइस पर पुराने Play Store संस्करण के कारण हो सकता है।</string>
  <string name="message_unknown_source">इस ऐप को Play से प्राप्त करें</string>
  <string name="message_unknown_source_detail">इस शानदार ऐप का उपयोग जारी रखने के लिए, इसे Google Play से प्राप्त करें।</string>
  <string name="message_force_update">अपडेट आवश्यक</string>
  <string name="message_force_update_detail">यह संस्करण अब समर्थित नहीं है।\nस्टोर पर जाएं।</string>
  <string name="message_service_unavailable">सेवा अनुपलब्ध है</string>
