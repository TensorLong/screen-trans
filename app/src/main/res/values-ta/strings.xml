    <string name="message_authentication_error">அங்கீகார பிழை</string>
    <string name="message_authentication_error_detail">அங்கீகார சேவையகம் பதிலளிக்கவில்லை.\nதயவுசெய்து பின்னர் முயற்சிக்கவும்.</string>
    <string name="message_untrusted_environment">நம்பிக்கையில்லா சூழல்</string>
    <string name="message_untrusted_environment_detail">Google Play செருகுநிலை சோதனையை உங்கள் பயன்பாடு கடந்து செல்லவில்லை போல தெரிகிறது.</string>
    <string name="message_unknown_device">அறியப்படாத சாதனம்</string>
    <string name="message_unknown_device_detail">இந்த சாதனம் ஆதரிக்கப்படவில்லை.</string>
    <string name="message_authentication_required">அங்கீகாரம் தேவை</string>
    <string name="message_authentication_required_detail">Google கணக்கில் உள்நுழைவது அவசியம்.</string>
    <string name="message_playstore_update_required">Play Store புதுப்பிப்பு தேவை</string>
    <string name="message_playstore_update_required_detail">Play Store சேவையை இணைக்க முடியவில்லை.\nஇது சாதனத்தில் பழைய பதிப்பு இருக்கக்கூடும் என்பதற்காக இருக்கலாம்.</string>
    <string name="message_unknown_source">இந்த பயன்பாட்டைப் Play-இல் பெறுங்கள்</string>
    <string name="message_unknown_source_detail">இந்த சிறந்த பயன்பாட்டைப் பயன்படுத்த தொடர, Google Play-இல் இருந்து பெறுங்கள்.</string>
    <string name="message_force_update">புதுப்பிப்பு தேவை</string>
    <string name="message_force_update_detail">இந்த பதிப்பு இனி ஆதரிக்கப்படாது.\nStore-க்கு செல்லவும்.</string>
    <string name="message_service_unavailable">சேவை கிடைக்கவில்லை</string>
    <string name="message_service_unavailable_detail">சேவை பராமரிப்பில் உள்ளது.</string>
    <string name="message_network_unavailable">நெட்வொர்க் கிடைக்கவில்லை</string>
    <string name="message_network_unavailable_detail">நெட்வொர்க் இல்லை.\nதயவுசெய்து சரிபார்த்து மீண்டும் முயற்சிக்கவும்.</string>
    <string name="message_translate_fixedarea_warn">மின்கலன் எச்சரிக்கை</string>
    <string name="message_translate_fixedarea_warn_detail">மின்கலன் விரைவாக தீரலாம்.</string>

